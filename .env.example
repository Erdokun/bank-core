# Required for real Veyra email verification. The sending domain must be
# authenticated by your SMTP provider for no-reply@veyra.com.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
PUBLIC_APP_URL=http://localhost:8000

# Replace in every non-development environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
