# Local development defaults. Compose also supplies these when no .env exists.
APP_ENV=development
BANK_SANDBOX=true
PUBLIC_APP_URL=http://localhost:8000

# Local email sink, accessible at http://localhost:8025.
# For real SMTP, replace host/port/sender and enable TLS (normally port 587).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Veyra <no-reply@veyra.local>
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false

# Generate a unique random secret for any shared or deployed instance.
JWT_SECRET_KEY=development-only-bank-core-key-change-before-deploy
