# Copy this file to .env, then fill in your own sender and Google app password.
# Never commit .env or paste your password into a chat.
APP_ENV=development
BANK_SANDBOX=true
PUBLIC_APP_URL=http://localhost:8000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=Veyra <YOUR_ADDRESS@gmail.com>
SMTP_USER=YOUR_ADDRESS@gmail.com
SMTP_PASSWORD=YOUR_16_CHARACTER_GOOGLE_APP_PASSWORD
SMTP_TLS=true
SMTP_SSL=false
JWT_SECRET_KEY=development-only-bank-core-key-change-before-deploy
